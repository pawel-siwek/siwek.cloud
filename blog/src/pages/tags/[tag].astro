---
import Base from '../../layouts/Base.astro';
import PostMeta from '../../components/PostMeta.astro';
import { TAG_LABELS } from '../../config';
import { TAGS } from '../../content.config';
import { getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return TAGS.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
interface Props { posts: Post[] }
const { posts } = Astro.props;
const { tag } = Astro.params;
const label = TAG_LABELS[tag!] ?? tag;
---
<Base title={`${label} — siwek.cloud blog`} description={`Posts tagged ${label} on siwek.cloud.`}>
  <span class="kicker">Tag</span>
  <h1 class="title">{label}</h1>
  {posts.length === 0 ? (
    <p class="empty">Nothing here yet. <a href="/blog/">Back to all posts</a>.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-card">
          <PostMeta post={post} />
          <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
  <a class="back" href="/blog/">← All posts</a>
</Base>
