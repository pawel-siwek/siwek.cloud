---
import '../styles/blog.css';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}
const { title, description, ogImage, type = 'website', publishedTime, noindex = false } = Astro.props;
// PR previews (SHOW_DRAFTS=1) are publicly reachable, so keep them out of search engines.
const robotsNoindex = noindex || process.env.SHOW_DRAFTS === '1';
const isBlog = !noindex && Astro.url.pathname.startsWith('/blog');
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const image = new URL(ogImage ?? '/blog/og/default.png', SITE.url).href;
const rss = new URL('/blog/rss.xml', SITE.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rss} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/png" sizes="32x32" href="/logo/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/logo/favicon-16.png" />
    <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;600;700&family=Archivo+Narrow:wght@700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a href="/" class="brand">
          <img src="/logo/siwek-cloud-mark.svg" alt="siwek.cloud" width="40" height="40" />
          <span class="brand-text">
            <span class="brand-name">SIWEK<span class="accent">.CLOUD</span></span>
            <span class="brand-sub">PRINCIPAL PRODUCT ARCHITECT · DYNATRACE · AZURE MVP</span>
          </span>
        </a>
        <nav class="site-nav">
          <a href="/blog/" aria-current={isBlog ? 'page' : undefined}>Blog</a>
          <a href="/waf/">Talks &amp; open source</a>
          <a href="https://github.com/pawelsiwek">GitHub</a>
          <a href="https://sessionize.com/pawel-siwek/">Sessionize</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© 1993–{new Date().getFullYear()} Paweł Siwek · Gdańsk, Poland</span>
        <span><a href="/blog/rss.xml">RSS</a></span>
        <span>This site runs on Azure Static Web Apps free tier. Monthly bill: €0.00. Cost optimization starts at home.</span>
      </footer>
    </div>
  </body>
</html>
