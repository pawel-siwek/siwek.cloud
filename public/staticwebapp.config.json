{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "routes": [
    { "route": "/waf", "redirect": "/waf/", "statusCode": 301 },
    { "route": "/support.js", "headers": { "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400" } },
    { "route": "/logo/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/blog/_astro/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/build.json", "headers": { "Cache-Control": "no-cache" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  }
}
